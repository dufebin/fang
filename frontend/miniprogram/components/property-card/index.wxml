<wxs module="fmt" src="../../utils/format.wxs" />

<view class="property-card {{compact ? 'property-card-compact' : ''}}" bindtap="onTap">
  <view class="card-image-wrap {{compact ? 'card-image-compact' : ''}}">
    <!-- 四图拼接（≥4 张：2×2） -->
    <view wx:if="{{fourImages && fourImgUrls.length >= 4}}" class="card-four-grid">
      <image
        wx:for="{{fourImgUrls}}"
        wx:key="index"
        class="card-grid-img"
        src="{{item}}"
        mode="aspectFill"
        lazy-load
        binderror="onGridImgError"
        data-idx="{{index}}"
      />
    </view>
    <!-- 三图：左大右二 -->
    <view wx:elif="{{fourImages && fourImgUrls.length === 3}}" class="grid-3">
      <image class="card-grid-img g-main" src="{{fourImgUrls[0]}}" mode="aspectFill" lazy-load binderror="onGridImgError" data-idx="0" />
      <view class="g-side">
        <image class="card-grid-img" src="{{fourImgUrls[1]}}" mode="aspectFill" lazy-load binderror="onGridImgError" data-idx="1" />
        <image class="card-grid-img" src="{{fourImgUrls[2]}}" mode="aspectFill" lazy-load binderror="onGridImgError" data-idx="2" />
      </view>
    </view>
    <!-- 两图：上下两张大图 -->
    <view wx:elif="{{fourImages && fourImgUrls.length === 2}}" class="grid-2">
      <image class="card-grid-img" src="{{fourImgUrls[0]}}" mode="aspectFill" lazy-load binderror="onGridImgError" data-idx="0" />
      <image class="card-grid-img" src="{{fourImgUrls[1]}}" mode="aspectFill" lazy-load binderror="onGridImgError" data-idx="1" />
    </view>
    <!-- 单图模式（默认） -->
    <image
      wx:elif="{{coverImage}}"
      class="card-image"
      src="{{coverImage}}"
      mode="aspectFill"
      lazy-load
      binderror="onCoverImgError"
    />
    <!-- 无图占位 -->
    <view wx:else class="card-image-empty">暂无图片</view>
    <view class="card-type-tag">{{fmt.typeLabel(property.property_type)}}</view>
    <view wx:if="{{showStatus}}" class="card-status-tag {{fmt.statusClass(property.status)}}">{{fmt.statusLabel(property.status)}}</view>
    <view wx:if="{{property.video_url && !compact}}" class="card-video-badge">▶ 视频</view>
  </view>

  <view class="card-body {{compact ? 'card-body-compact' : ''}}">
    <view class="card-title {{compact ? 'card-title-compact' : ''}}">{{property.title}}</view>
    <view wx:if="{{!compact}}" class="card-location">
      {{property.district || '区域待补充'}}<text wx:if="{{property.address}}"> · {{property.address}}</text>
    </view>
    <view class="card-meta {{compact ? 'card-meta-compact' : ''}}">
      <text>{{fmt.formatLayout(property.bedrooms, property.living_rooms, property.bathrooms)}}</text>
      <text class="dot">·</text>
      <text>{{fmt.formatArea(property.area)}}</text>
      <text wx:if="{{!compact && property.unit_price}}" class="dot">·</text>
      <text wx:if="{{!compact && property.unit_price}}">约{{property.unit_price}}元/㎡</text>
    </view>
    <view wx:if="{{!compact && quickTags.length}}" class="card-tags">
      <text wx:for="{{quickTags}}" wx:key="*this" class="card-tag">{{item}}</text>
    </view>
    <view class="card-bottom {{compact ? 'card-bottom-compact' : ''}}">
      <text class="price-num {{compact ? 'price-compact' : ''}}">{{fmt.formatPrice(property.total_price, property.property_type === 'rent' ? 'rent' : 'sale')}}</text>
      <text wx:if="{{!compact}}" class="views-text">{{property.view_count}}次浏览</text>
    </view>
  </view>
</view>
