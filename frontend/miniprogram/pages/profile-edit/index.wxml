<view class="page">
  <view class="page-title">编辑资料</view>

  <!-- 点击头像使用微信头像（2022+ 新 API） -->
  <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
    <image class="avatar-preview" src="{{avatarUrl}}" mode="aspectFill" />
    <text class="avatar-hint">点击使用微信头像</text>
  </button>

  <!-- 昵称输入，type="nickname" 会自动填入微信昵称 -->
  <view class="nickname-wrap">
    <input
      class="nickname-input"
      type="nickname"
      placeholder="请输入昵称（可自动填入微信昵称）"
      value="{{nickname}}"
      bindinput="onNicknameInput"
      maxlength="20"
    />
  </view>

  <button class="save-btn" bindtap="onSave" loading="{{saving}}">
    保存
  </button>
</view>
