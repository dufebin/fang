.page {
  background: #fff;
  min-height: 100vh;
}

/* ---------- 参考图输入区 ---------- */
.loan-tabs {
  display: flex;
  height: 124rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.loan-tab {
  flex: 1;
  line-height: 124rpx;
  text-align: center;
  font-size: 30rpx;
  color: #222;
}

.loan-tab-active {
  color: #3072F6;
}

.loan-form {
  padding-left: 48rpx;
  padding-right: 48rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 122rpx;
  border-bottom: 2rpx solid #EEE;
  box-sizing: border-box;
}

.row-no-border {
  border-bottom: none;
}

.combo-group-start {
  margin-top: 20rpx;
}

.row-label {
  width: 200rpx;
  flex: none;
  font-size: 30rpx;
  color: #222;
}

.row-value {
  flex: 1;
  display: flex;
  align-items: center;
}

.row-input {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: left;
  font-size: 30rpx;
  color: #000;
}

.row-text {
  flex: 1;
  font-size: 30rpx;
  color: #000;
  white-space: nowrap;
}

.row-unit {
  flex: none;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.chevron {
  width: 14rpx;
  height: 14rpx;
  flex: none;
  margin-right: 6rpx;
  border-right: 2rpx solid #999;
  border-bottom: 2rpx solid #999;
  transform: rotate(-45deg);
  transition: transform .2s ease;
}

.mode-options {
  flex: 1;
  display: flex;
  align-items: center;
}

.mode-option {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #222;
  white-space: nowrap;
}

.mode-option + .mode-option {
  margin-left: 50rpx;
}

.radio {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex: none;
  box-sizing: border-box;
  margin-right: 20rpx;
  border: 2rpx solid #CCC;
  border-radius: 50%;
  background: #fff;
}

.radio-on {
  border-color: #3072F6;
  background: #3072F6;
}

.radio-check {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 12rpx;
  height: 7rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg);
}

.lpr-wrap {
  padding-bottom: 32rpx;
  border-bottom: 2rpx solid #EEE;
}

.lpr-panel {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #F4F7FE;
}

.new-badge {
  width: 62rpx;
  height: 26rpx;
  flex: none;
  border-radius: 4rpx;
  background: #3072F6;
  color: #fff;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 26rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

.lpr-text {
  margin-left: 20rpx;
  font-size: 20rpx;
  color: #333;
  white-space: nowrap;
}

.lpr-history {
  margin-left: auto;
  font-size: 20rpx;
  color: #3072F6;
  white-space: nowrap;
}

.combo-rate-input {
  flex: none;
  width: 72rpx;
}

.rate-suffix {
  font-size: 30rpx;
  color: #000;
  white-space: nowrap;
}

.calc-btn {
  height: 100rpx;
  margin-top: 80rpx;
  border-radius: 8rpx;
  background: #3072F6;
  color: #fff;
  font-size: 30rpx;
  line-height: 100rpx;
  text-align: center;
}

.calc-btn-hover {
  opacity: .85;
}

.page-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 80rpx;
  padding-bottom: 60rpx;
  color: #3072F6;
  font-size: 24rpx;
  line-height: 40rpx;
}

.footer-divider {
  margin-left: 24rpx;
  margin-right: 24rpx;
}

/* ---------- 结果区容器（参考图未覆盖，保留原展示） ---------- */
.results {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--color-bg);
}

.results .card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 20rpx rgba(2, 132, 199, .06);
}

/* ---------- 结果卡（白底蓝数字，贝壳式） ---------- */
.result-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 20rpx rgba(2, 132, 199, 0.06);
}

.rc-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.rc-amount {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.15;
  letter-spacing: 2rpx;
}

.rc-unit {
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 4rpx;
}

.rc-per {
  font-size: 28rpx;
  font-weight: 400;
  color: #64748b;
  margin-left: 8rpx;
}

.rc-sub {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.rc-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.rc-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
}

.rc-cell-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.rc-cell-label {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 两种还款方式对比 */
.cmp {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.cmp-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  box-sizing: border-box;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}

.cmp-hover {
  background: #f8fafc;
}

.cmp-on {
  border-color: var(--color-primary);
  background: #f0f9ff;
}

.cmp-name {
  font-size: 24rpx;
  color: #475569;
}

.cmp-on .cmp-name {
  color: var(--color-primary);
  font-weight: 600;
}

.cmp-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-top: 4rpx;
}

.cmp-on .cmp-val {
  color: var(--color-primary);
}

.cmp-sub {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 本息占比条（本金主色填充，轨道即利息色） */
.bar {
  height: 20rpx;
  border-radius: 999rpx;
  background: #cbd5e1;
  margin-top: 28rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-primary);
  transition: width 0.3s ease;
}

.bar-legend {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #64748b;
  gap: 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-item + .legend-item {
  margin-left: 16rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 6rpx;
}

.dot-principal {
  background: var(--color-primary);
}

.dot-interest {
  background: #cbd5e1;
}

.bar-months {
  margin-left: auto;
  color: #94a3b8;
}

/* ---------- 还款明细（按年折叠） ---------- */
.schedule-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 20rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.schedule-hint {
  font-size: 20rpx;
  font-weight: 400;
  color: #94a3b8;
}

.schedule-header,
.schedule-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  padding: 18rpx 8rpx;
}

.schedule-header {
  color: #94a3b8;
  font-weight: 500;
}

.schedule-row {
  color: #334155;
  border-bottom: 1rpx solid #f1f5f9;
}

.col-year {
  flex: 1;
  text-align: left;
}

.col-num {
  flex: 1.4;
  text-align: right;
}

.col-arrow {
  width: 40rpx;
  display: flex;
  justify-content: flex-end;
}

.chevron-sm {
  width: 12rpx;
  height: 12rpx;
  margin-left: 0;
}

.chevron-open {
  transform: rotate(-135deg);
}

/* 展开的月供明细（5 列） */
.months {
  background: #f8fafc;
  border-bottom: 1rpx solid #f1f5f9;
  padding: 8rpx 8rpx 16rpx;
}

.month-head,
.month-row {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  padding: 10rpx 0;
}

.month-head {
  color: #94a3b8;
  font-weight: 500;
}

.month-row {
  color: #334155;
}

.month-head text,
.month-row text {
  flex: 1;
  text-align: right;
}

.month-head text:first-child,
.month-row text:first-child {
  flex: 0.5;
  text-align: left;
  color: #94a3b8;
}

/* ---------- 参考图底部选择器 ---------- */
.sheet-mask {
  display: none;
  position: fixed;
  left: 0rpx;
  top: 0rpx;
  right: 0rpx;
  bottom: 0rpx;
  z-index: 100;
  background: #00000066;
}

.sheet {
  display: none;
  position: fixed;
  left: 0rpx;
  right: 0rpx;
  bottom: 0rpx;
  z-index: 101;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
}

.sheet-mask-show,
.sheet-show {
  display: block;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 82rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
}

.sheet-btn {
  font-size: 32rpx;
  color: #408CE2;
}

.sheet-picker {
  height: 480rpx;
}

.sheet-opt {
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  font-size: 30rpx;
  color: #141414;
}

.sheet-opt-active {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
}
