.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 24rpx;
}

/* ---------- 输入卡片 ---------- */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 20rpx rgba(2, 132, 199, 0.06);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 26rpx;
  color: #64748b;
  display: block;
  margin-bottom: 14rpx;
}

.form-input {
  height: 84rpx;
  background: var(--color-bg);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #0f172a;
  width: 100%;
  box-sizing: border-box;
}

.input-ph {
  color: #94a3b8;
  font-weight: 400;
}

/* 贷款金额行（浅蓝底强调） */
.loan-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f0f9ff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin: 8rpx 0 32rpx;
}

.loan-line .form-label {
  margin-bottom: 0;
  color: #0369a1;
  font-weight: 600;
}

.loan-amount-val {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.loan-amount-val .unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #0369a1;
  margin-left: 4rpx;
}

/* 胶囊选择器（首付比例 / 年限） */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  min-width: 96rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #475569;
  background: #f1f5f9;
  transition: background-color 0.15s ease, color 0.15s ease;
}

.chip-hover {
  background: #e2e8f0;
}

.chip-active {
  color: #fff;
  background: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(2, 132, 199, 0.25);
}

/* 分段控件（还款方式） */
.seg {
  display: flex;
  background: #f1f5f9;
  border-radius: 999rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: #475569;
  border-radius: 999rpx;
}

.seg-active {
  background: #fff;
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.12);
}

/* 计算按钮 */
.calc-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(2, 132, 199, 0.3);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.calc-btn-hover {
  transform: scale(0.98);
  opacity: 0.92;
}

/* ---------- 结果卡（白底蓝数字，贝壳式） ---------- */
.result-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 20rpx rgba(2, 132, 199, 0.06);
}

.rc-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.rc-amount {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.15;
}

.rc-sub {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.rc-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.rc-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
}

.rc-cell-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.rc-cell-label {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 两种还款方式对比 */
.cmp {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.cmp-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  box-sizing: border-box;
}

.cmp-on {
  border-color: var(--color-primary);
  background: #f0f9ff;
}

.cmp-name {
  font-size: 24rpx;
  color: #475569;
}

.cmp-on .cmp-name {
  color: var(--color-primary);
  font-weight: 600;
}

.cmp-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-top: 4rpx;
}

.cmp-on .cmp-val {
  color: var(--color-primary);
}

.cmp-sub {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 本息占比条 */
.bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  margin-top: 28rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.bar-legend {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #64748b;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 6rpx;
}

.dot-principal {
  background: var(--color-primary);
}

.dot-interest {
  background: #cbd5e1;
  margin-left: 20rpx;
}

.bar-months {
  margin-left: auto;
  color: #94a3b8;
}

/* ---------- 还款明细表 ---------- */
.schedule-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 20rpx;
}

.schedule-header,
.schedule-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  padding: 18rpx 8rpx;
}

.schedule-header {
  color: #94a3b8;
  font-weight: 500;
}

.schedule-row {
  color: #334155;
  border-bottom: 1rpx solid #f1f5f9;
}

.col-year {
  flex: 1;
  text-align: left;
}

.col-num {
  flex: 1.4;
  text-align: right;
}
