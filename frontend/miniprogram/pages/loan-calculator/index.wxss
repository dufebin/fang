.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 24rpx;
}

/* ---------- 输入卡片 ---------- */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 20rpx rgba(2, 132, 199, 0.06);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 12rpx;
}

/* 行式表单：左标签 + 右值，行间细分割线 */
.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.row-label {
  font-size: 28rpx;
  color: #475569;
  flex-shrink: 0;
}

.row-value-box {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  min-width: 0;
}

.row-input {
  text-align: right;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  flex: 1;
  min-width: 0;
}

.row-val-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.row-unit {
  font-size: 24rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.input-ph {
  color: #94a3b8;
  font-weight: 400;
}

.row-tap {
  cursor: pointer;
}

.row-hover {
  background: #f8fafc;
}

/* 右箭头（CSS 绘制） */
.chevron {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #cbd5e1;
  border-bottom: 3rpx solid #cbd5e1;
  transform: rotate(-45deg);
  margin-left: 12rpx;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

/* 贷款金额行（浅蓝底强调） */
.loan-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f0f9ff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}

.loan-line .row-label {
  color: #0369a1;
  font-weight: 600;
}

.loan-amount-val {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.loan-amount-val .unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #0369a1;
  margin-left: 4rpx;
}

/* 分段控件（贷款种类 / 还款方式，行内紧凑版） */
.seg {
  display: flex;
  background: #f1f5f9;
  border-radius: 999rpx;
  padding: 6rpx;
}

.seg-row {
  margin-left: 24rpx;
  flex: 1;
}

.seg-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #475569;
  border-radius: 999rpx;
}

.seg-active {
  background: #fff;
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.12);
}

/* 计算按钮 */
.calc-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(2, 132, 199, 0.3);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.calc-btn-hover {
  transform: scale(0.98);
  opacity: 0.92;
}

/* ---------- 结果卡（白底蓝数字，贝壳式） ---------- */
.result-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 20rpx rgba(2, 132, 199, 0.06);
}

.rc-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.rc-amount {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.15;
  letter-spacing: 2rpx;
}

.rc-unit {
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 4rpx;
}

.rc-per {
  font-size: 28rpx;
  font-weight: 400;
  color: #64748b;
  margin-left: 8rpx;
}

.rc-sub {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.rc-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.rc-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
}

.rc-cell-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.rc-cell-label {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 两种还款方式对比 */
.cmp {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.cmp-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  box-sizing: border-box;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}

.cmp-hover {
  background: #f8fafc;
}

.cmp-on {
  border-color: var(--color-primary);
  background: #f0f9ff;
}

.cmp-name {
  font-size: 24rpx;
  color: #475569;
}

.cmp-on .cmp-name {
  color: var(--color-primary);
  font-weight: 600;
}

.cmp-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-top: 4rpx;
}

.cmp-on .cmp-val {
  color: var(--color-primary);
}

.cmp-sub {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 本息占比条（本金主色填充，轨道即利息色） */
.bar {
  height: 20rpx;
  border-radius: 999rpx;
  background: #cbd5e1;
  margin-top: 28rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-primary);
  transition: width 0.3s ease;
}

.bar-legend {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #64748b;
  gap: 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-item + .legend-item {
  margin-left: 16rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 6rpx;
}

.dot-principal {
  background: var(--color-primary);
}

.dot-interest {
  background: #cbd5e1;
}

.bar-months {
  margin-left: auto;
  color: #94a3b8;
}

/* ---------- 还款明细（按年折叠） ---------- */
.schedule-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 20rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.schedule-hint {
  font-size: 20rpx;
  font-weight: 400;
  color: #94a3b8;
}

.schedule-header,
.schedule-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  padding: 18rpx 8rpx;
}

.schedule-header {
  color: #94a3b8;
  font-weight: 500;
}

.schedule-row {
  color: #334155;
  border-bottom: 1rpx solid #f1f5f9;
}

.col-year {
  flex: 1;
  text-align: left;
}

.col-num {
  flex: 1.4;
  text-align: right;
}

.col-arrow {
  width: 40rpx;
  display: flex;
  justify-content: flex-end;
}

.chevron-sm {
  width: 12rpx;
  height: 12rpx;
  margin-left: 0;
}

.chevron-open {
  transform: rotate(-135deg);
}

/* 展开的月供明细（5 列） */
.months {
  background: #f8fafc;
  border-bottom: 1rpx solid #f1f5f9;
  padding: 8rpx 8rpx 16rpx;
}

.month-head,
.month-row {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  padding: 10rpx 0;
}

.month-head {
  color: #94a3b8;
  font-weight: 500;
}

.month-row {
  color: #334155;
}

.month-head text,
.month-row text {
  flex: 1;
  text-align: right;
}

.month-head text:first-child,
.month-row text:first-child {
  flex: 0.5;
  text-align: left;
  color: #94a3b8;
}

/* ---------- 底部选择器弹层 ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.28s ease, visibility 0.28s ease;
  z-index: 100;
}

.sheet-mask-show {
  opacity: 1;
  visibility: visible;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.28s ease;
  z-index: 101;
}

.sheet-show {
  transform: translateY(0);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.sheet-btn {
  font-size: 28rpx;
  color: #64748b;
  padding: 12rpx 8rpx;
}

.sheet-btn-hover {
  opacity: 0.6;
}

.sheet-confirm {
  color: var(--color-primary);
  font-weight: 600;
}

.sheet-picker {
  height: 400rpx;
}

.sheet-opt {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: #0f172a;
}
